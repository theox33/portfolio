---
const { baseUrl = import.meta.env.BASE_URL || '/' } = Astro.props;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<div id="languageToggle" data-locales-base={normalizedBase + 'locales/'} class="fixed top-4 right-4 z-50 rounded-md shadow-md p-2 text-sm language-toggle">
  <div class="relative">
    <button id="langBtn" aria-haspopup="listbox" aria-expanded="false" class="language-pill flex items-center gap-3 px-4 py-2 rounded-full font-medium focus:outline-none">
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 4h-2v6l5 3 .9-1.5-4.9-2.5V6z"/></svg>
      <span id="langLabel" class="text-white">FR</span>
    </button>

    <ul id="langList" role="listbox" tabindex="-1" class="absolute right-0 mt-2 w-36 bg-white rounded-md shadow-lg overflow-hidden hidden">
      <li data-lang="fr" role="option" class="px-3 py-2 hover:bg-gray-100 cursor-pointer">Français</li>
      <li data-lang="en" role="option" class="px-3 py-2 hover:bg-gray-100 cursor-pointer">English</li>
    </ul>
  </div>
</div>

<style>
  .language-toggle {
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(0,0,0,0.08);
  }
  :root .language-toggle { /* default (fancy) */ }
  .professional-mode .language-toggle {
    background: rgba(20,23,33,0.75);
    border-color: rgba(59,130,246,0.12);
    color: #e6eefb;
  }
  .language-toggle select { color: inherit; }

  .language-toggle select { background: transparent; }
  .professional-mode .language-toggle select { color: #e6eefb; }
  .language-toggle:focus-within { box-shadow: 0 6px 20px rgba(99,102,241,0.12); }
  .language-pill{ background: linear-gradient(90deg,#8b5cf6,#ec4899); padding:6px 12px; }
  .language-pill:hover{ transform: translateY(-2px); box-shadow: 0 10px 30px rgba(99,102,241,0.15); }
  .language-pill svg{ opacity:0.98 }
  .language-toggle .hidden{ display:none }
  .language-toggle ul{ z-index:60 }
  .professional-mode .language-pill{ background: linear-gradient(90deg,#2563eb,#06b6d4); }
  .professional-mode .language-pill:hover{ box-shadow: 0 10px 30px rgba(37,99,235,0.12); }
  /* Dropdown readability */
  .language-toggle ul{ background: #ffffff; color: #000000; box-shadow: 0 8px 24px rgba(15,23,42,0.12); }
  .language-toggle ul li{ color: inherit }
  .language-toggle ul li:hover{ background: #f3f4f6 }
  .professional-mode .language-toggle ul{ background: #0b1220; color: #e6eefb }
  .professional-mode .language-toggle ul li:hover{ background: rgba(255,255,255,0.03) }
</style>

<script is:inline>
    (function() {
    const toggleEl = document.getElementById('languageToggle');
    const LOCALES_BASE = (toggleEl && toggleEl.dataset && toggleEl.dataset.localesBase) ? toggleEl.dataset.localesBase : '/locales/';
    const select = document.getElementById('langSelect');

    // Sync visual state with theme
    function applyLanguageToggleTheme(){
      const root = document.documentElement;
      const el = document.querySelector('.language-toggle');
      if(!el) return;
      if(root.classList.contains('professional-mode')){
        el.classList.add('professional-mode');
      } else {
        el.classList.remove('professional-mode');
      }
    }

    // Observe theme class changes on documentElement
    const mo = new MutationObserver(muts=>{
      for(const m of muts) if(m.attributeName === 'class') applyLanguageToggleTheme();
    });
    mo.observe(document.documentElement, { attributes: true });
    applyLanguageToggleTheme();

    function getPreferred() {
      const stored = window.localStorage.getItem('site_lang');
      if (stored) return stored;
      const nav = navigator.language || navigator.userLanguage || 'fr';
      return nav.split('-')[0];
    }

    async function loadLang(lang) {
      try {
        const res = await fetch(LOCALES_BASE + `${lang}.json`);
        if (!res.ok) throw new Error('Locale not found');
        const json = await res.json();
        window.__i18n = json;
        window.localStorage.setItem('site_lang', lang);
        window.dispatchEvent(new CustomEvent('i18n:change', { detail: json }));
      } catch (e) {
        console.warn('Could not load locale', lang, e);
      }
    }

  // Init selector UI
  const preferred = getPreferred();
  const initial = (preferred === 'fr' || preferred === 'en') ? preferred : 'en';
  const langBtn = document.getElementById('langBtn');
  const langLabel = document.getElementById('langLabel');
  const langList = document.getElementById('langList');
  function setLabel(l){ if(langLabel) langLabel.textContent = l.toUpperCase(); }
  setLabel(initial);
  loadLang(initial);

    // Auto-detect: if user lang is different and no stored pref -> load it
    const stored = window.localStorage.getItem('site_lang');
    if (!stored) {
      const nav = navigator.language || navigator.userLanguage || 'fr';
      const auto = (nav.split('-')[0] === 'fr') ? 'fr' : 'en';
      if (auto !== select.value) {
        setLabel(auto);
        loadLang(auto);
      }
    }

    // Dropdown behavior
    langBtn?.addEventListener('click', (e)=>{
      const expanded = langBtn.getAttribute('aria-expanded') === 'true';
      langBtn.setAttribute('aria-expanded', String(!expanded));
      langList.classList.toggle('hidden');
    });
    langList?.addEventListener('click', (e)=>{
      const li = e.target.closest('[data-lang]');
      if(!li) return;
      const v = li.getAttribute('data-lang');
      setLabel(v);
      loadLang(v);
      langList.classList.add('hidden');
      if(langBtn) langBtn.setAttribute('aria-expanded','false');
    });

    // Close on outside click
    document.addEventListener('click', (e)=>{
      if(!e.composedPath().includes(toggleEl)){
        langList.classList.add('hidden');
        langBtn?.setAttribute('aria-expanded','false');
      }
    });
  })();
</script>
