---
// Layout component: wraps pages and provides global structure
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import profile from '../content/profile.json';

const baseUrl = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = 'Théo AVRIL - Ingénieur Systèmes Embarqués | Portfolio', 
  description = 'Découvrez le parcours, les projets et le portfolio de Théo AVRIL, ingénieur spécialisé en systèmes embarqués, développement C/C++, Linux embarqué et architecture logicielle.',
  image = `${Astro.site}${baseUrl}images/avatar.png`.replace(/\/+/g, '/').replace(':/', '://')
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageUrl = image.startsWith('http') ? image : new URL(image, Astro.site).href;
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Théo AVRIL" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Théo AVRIL, Théo Avril, ingénieur systèmes embarqués, développement C, C++, Linux embarqué, RTOS, portfolio ingénieur, ESEO Angers, systèmes embarqués France" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Portfolio de Théo AVRIL" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    
    <!-- Structured Data / Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Théo AVRIL",
      "alternateName": "Théo Avril",
      "jobTitle": "Ingénieur Systèmes Embarqués",
      "description": description,
      "url": canonicalURL.href,
      "image": fullImageUrl,
      "sameAs": [
        profile.contact.linkedin,
        profile.contact.github,
        profile.contact.portfolio
      ],
      "email": profile.contact.email,
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "ESEO - École Supérieure de l'Électronique de l'Ouest",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Angers",
          "addressCountry": "FR"
        }
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Angers",
        "addressCountry": "FR"
      },
      "knowsLanguage": [
        {
          "@type": "Language",
          "name": "Français",
          "alternateName": "fr"
        },
        {
          "@type": "Language",
          "name": "Anglais",
          "alternateName": "en"
        }
      ]
    })} />
    
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <ViewTransitions />
  </head>
  <body class="bg-pattern text-gray-100 font-sans">
    <!-- Custom cursor -->
    <div class="cursor"></div>
    <div class="cursor-follower"></div>

    <Header />
    <NavBar />
    <main class="max-w-7xl mx-auto">
      <slot />
    </main>
  <Footer />
  <ThemeToggle />
  <LanguageToggle baseUrl={baseUrl} />
    
    <!-- Scripts for animations -->
    <script>
      import '../scripts/animations.js';
    </script>
    
    <!-- Custom cursor script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const cursor = document.querySelector('.cursor');
        const follower = document.querySelector('.cursor-follower');
        
        let mouseX = 0, mouseY = 0;
        let followerX = 0, followerY = 0;
        
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          
          if (cursor) {
            cursor.style.left = mouseX + 'px';
            cursor.style.top = mouseY + 'px';
          }
        });
        
        function animateFollower() {
          followerX += (mouseX - followerX) * 0.1;
          followerY += (mouseY - followerY) * 0.1;
          
          if (follower) {
            follower.style.left = followerX + 'px';
            follower.style.top = followerY + 'px';
          }
          
          requestAnimationFrame(animateFollower);
        }
        
        animateFollower();
        
        // Grow cursor on hover over interactive elements
        const interactiveElements = document.querySelectorAll('a, button, .project-card');
        interactiveElements.forEach(el => {
          el.addEventListener('mouseenter', () => {
            if (cursor) cursor.style.transform = 'translate(-50%, -50%) scale(1.5)';
          });
          el.addEventListener('mouseleave', () => {
            if (cursor) cursor.style.transform = 'translate(-50%, -50%) scale(1)';
          });
        });
      });
    </script>

    <!-- i18n runtime: apply translations to elements with data-i18n -->
    <script is:inline>
      (function() {
        function applyTranslations(translations) {
          if (!translations) return;
          document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            const parts = key.split('.');
            let val = translations;
            for (const p of parts) {
              val = val && val[p];
            }
            if (val) {
              el.textContent = val;
            }
          });
        }

        // Apply existing global translations if already loaded
        if (window.__i18n) applyTranslations(window.__i18n);

        // Listen for language changes
        window.addEventListener('i18n:change', (e) => {
          applyTranslations(e.detail);
        });
      })();
    </script>
  </body>
</html>
